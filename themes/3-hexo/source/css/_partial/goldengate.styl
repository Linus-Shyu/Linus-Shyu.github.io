// Golden Gate moonrise — homepage timelapse band.
// Frames are a real time sequence (moon drifts from upper left to the tower
// tip); goldengate.js cross-fades them. Only rendered on the homepage.

// Full-window immersive band.
//
// The reading column is capped at 900px, far too small for a 4K photograph —
// the bridge lost all its detail at that width. The band therefore escapes the
// column and spans the whole content viewport, while the article text below
// keeps its usual measure.
//
// Sidebar geometry, measured from the theme (not assumed):
//   >=1920px   .nav is 542px, relative/float-left  -> content starts at 542
//   1024-1440  .nav is 492px, relative/float-left  -> content starts at 492
//   <=1024     .nav is absolute (an overlay)       -> content starts at 0
// Keeping these values in sync with the media queries below is what makes the
// band land exactly at the sidebar's right edge.
//
// `left` is used instead of negative margins because the column's overflow
// clipping would otherwise win; a viewport-relative offset is not clipped.

.gg-hero
  position relative
  padding 0
  overflow hidden
  background #0a1526
  isolation isolate
  // Native 16:9 frame so the photograph is never cropped.
  aspect-ratio 16 / 9
  margin-top -2.5em
  margin-bottom 1.5em

// Floor: sidebar is an overlay, content spans the full width.
.gg-hero
  width 100vw
  margin-left 0
  left calc(-50vw + 50%)

@media screen and (min-width 1025px)
  .gg-hero
    // Sidebar occupies 492px of the layout.
    width calc(100vw - 492px)
    left calc(-50vw + 246px + 50%)

@media screen and (min-width 1441px)
  .gg-hero
    // Sidebar widens to 542px.
    width calc(100vw - 542px)
    left calc(-50vw + 271px + 50%)

.gg-timelapse
  position absolute
  inset 0
  overflow hidden

.gg-timelapse__frame
  position absolute
  inset 0
  opacity 0
  transition opacity 1.6s ease-in-out
  will-change opacity
  &.is-active
    opacity 1

.gg-timelapse__img
  display block
  width 100%
  height 100%
  // contain, not cover: the whole photograph must stay visible. On a viewport
  // narrower than 16:9 the frame shrinks to fit rather than cropping the moon.
  object-fit contain
  object-position 50% 50%
  // Very slight drift keeps the still composition alive between cross-fades;
  // kept under 1.5% so no part of the image is pushed out of frame.
  animation gg-drift 26s ease-in-out infinite alternate

.gg-hero.is-static
  .gg-timelapse__img
    animation none

@keyframes gg-drift
  from
    transform scale(1.001)
  to
    transform scale(1.015)

// Legibility scrim: dark at the bottom so text over it stays readable,
// transparent at the top to keep the moon crisp.
.gg-hero__veil
  position absolute
  inset 0
  pointer-events none
  z-index 3
  background linear-gradient(
    180deg,
    rgba(8, 16, 30, 0.10) 0%,
    rgba(8, 16, 30, 0.18) 42%,
    rgba(8, 16, 30, 0.72) 100%
  )

.gg-hero__caption
  position absolute
  left 0
  right 0
  bottom 0
  z-index 4
  padding 0 2rem 1.35rem
  max-width 900px
  margin 0 auto
  display flex
  align-items baseline
  justify-content space-between
  gap 1rem
  flex-wrap wrap
  color rgba(255, 255, 255, 0.92)
  text-shadow 0 1px 12px rgba(0, 0, 0, 0.55)

.gg-hero__title
  margin 0
  font-size 0.95rem
  font-weight 500
  letter-spacing 0.02em

.gg-hero__meta
  margin 0
  font-size 0.72rem
  letter-spacing 0.14em
  text-transform uppercase
  color rgba(255, 255, 255, 0.62)

@media screen and (max-width 768px)
  .gg-hero__caption
    padding 0 1.25rem 0.9rem
  .gg-hero__title
    font-size 0.85rem

@media (prefers-reduced-motion: reduce)
  .gg-timelapse__frame
    transition none

// The band is wider than the reading column, so the two clipping ancestors must
// stop clipping on the homepage. Scoped to the index page: article pages keep
// their normal scroll containers and never render this band.
#post.index
  .pjax
    overflow-x visible
    overflow-y visible
